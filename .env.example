# Connection configuration: .env or tiktok-shop-monitor.env in the project root.
# Replace the example credentials. Percent-encode special characters in passwords.
DATABASE_URL=mysql+pymysql://tiktok_monitor:replace_me@127.0.0.1:3306/tiktok_shop_monitor?charset=utf8mb4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# Scheduler / Worker connections; values remain in ignored local env files.
# URL-encode special characters in usernames and passwords.
# RABBITMQ_URL=amqp://tiktok_monitor:replace_me@127.0.0.1:5672/%2F
# REDIS_URL=redis://127.0.0.1:6379/0
# API_TOKEN: at least 24 random characters. Omit it to disable write APIs.
# API_TOKEN=
# Opt-in: shop_discovery,product_discovery,product_detail,product_snapshot,change_detection,report_generation.
# Periodic monitoring additionally requires an explicit TOML product list and switch.
ENABLED_TASK_TYPES=
