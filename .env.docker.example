# Copy to deployment.env, then replace all example credentials locally.
# This stack uses its own named MySQL volume, not the host's existing database.
MYSQL_DATABASE=tiktok_shop_monitor
MYSQL_USER=tiktok_monitor
MYSQL_PASSWORD=replace_mysql_password
MYSQL_ROOT_PASSWORD=replace_root_password
DATABASE_URL=mysql+pymysql://tiktok_monitor:replace_mysql_password@mysql:3306/tiktok_shop_monitor?charset=utf8mb4
RABBITMQ_USER=tiktok_monitor
RABBITMQ_PASSWORD=replace_rabbitmq_password
RABBITMQ_URL=amqp://tiktok_monitor:replace_rabbitmq_password@rabbitmq:5672/%2F
REDIS_URL=redis://redis:6379/0
API_TOKEN=
ENABLED_TASK_TYPES=
